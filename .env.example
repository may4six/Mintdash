# ─────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────
# Postgres connection string. On Railway: add a "Postgres" plugin to your
# project, then copy its DATABASE_URL (Railway exposes it as a reference
# variable — you can usually just set this to ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://user:password@localhost:5432/mintdash"

# ─────────────────────────────────────────────────────────────────────────
# CLERK AUTH — https://dashboard.clerk.com → your app → API Keys
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─────────────────────────────────────────────────────────────────────────
# CHAIN RPC ENDPOINTS (client-side — used by wagmi/viem in the browser)
# Get free RPC URLs from Alchemy, Infura, or another provider. Public
# fallback RPCs work but are rate-limited and not reliable for production.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-key"
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your-key"

# WalletConnect Cloud project ID — https://cloud.reown.com
# Optional: without it, wallet connection falls back to browser-injected
# wallets only (MetaMask, Rabby, etc.), which is fine for most workflows.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ─────────────────────────────────────────────────────────────────────────
# CONTRACT ABI AUTO-DETECT (server-side only, never exposed to the client)
# Etherscan's v2 API now covers mainnet + Sepolia with a single key.
# https://etherscan.io/myapikey
# ─────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# SEEDING (optional, local/dev only)
# After signing in once, copy your Clerk user ID (Clerk dashboard → Users)
# here so `npm run db:seed` attaches demo wallets/campaigns to your account
# instead of a placeholder one.
# ─────────────────────────────────────────────────────────────────────────
SEED_USER_ID=""
